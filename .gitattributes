# Normalize line endings to LF on checkout
* text=auto eol=lf

# Kotlin source files
*.kt text eol=lf
*.kts text eol=lf

# XML resources
*.xml text eol=lf

# Markdown
*.md text eol=lf

# YAML / JSON
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf

# Binary files — no line ending conversion
*.apk binary
*.aar binary
*.aab binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.jks binary
*.keystore binary
*.so binary

# Gradle wrapper — must be binary-safe
gradlew text eol=lf
gradlew.bat text eol=crlf
gradle/wrapper/gradle-wrapper.jar binary
